---
// Anlık önerili ürün/kategori araması. Header'da (masaüstü) ve mobil ikinci satırda kullanılır.
// İndeks sayfaya bir kez gömülür (#arama-indeksi), bu bileşen onu okur.
import Icon from '../ui/Icon.astro';
import { POPULAR_SEARCHES } from '../../lib/search-index';

export interface Props {
  id: string;
  class?: string;
  /** "/" kısayolu sadece masaüstü örneğinde aktif */
  hotkey?: boolean;
}

const { id, class: className, hotkey = false } = Astro.props;
---

<div class:list={['header-search relative', className]} data-search data-hotkey={hotkey ? '' : undefined}>
  <form action="/arama/" method="get" role="search" class="relative" data-search-form>
    <label for={id} class="sr-only">Ürün veya kategori ara</label>
    <Icon
      name="Search"
      class="pointer-events-none absolute top-1/2 left-4 size-4.5 -translate-y-1/2 text-steel-500"
    />
    <input
      id={id}
      name="q"
      type="search"
      placeholder="Ürün, kategori veya model ara…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls={`${id}-liste`}
      aria-autocomplete="list"
      class="peer h-11 w-full rounded-full border border-transparent bg-white pr-24 pl-11 text-base text-steel-900 lg:text-[0.95rem] shadow-[inset_0_0_0_1px_var(--color-steel-200)] transition-shadow outline-none placeholder:text-steel-500 focus:shadow-[inset_0_0_0_2px_var(--color-signal-500)] lg:h-12 [&::-webkit-search-cancel-button]:hidden"
      data-search-input
    />
    {
      hotkey && (
        <kbd
          class="pointer-events-none absolute top-1/2 right-20 hidden -translate-y-1/2 rounded-md border border-steel-200 px-1.5 text-xs font-medium text-steel-500 peer-focus:hidden peer-[:not(:placeholder-shown)]:hidden xl:block"
          aria-hidden="true"
        >
          /
        </kbd>
      )
    }
    <button
      type="submit"
      class="absolute top-1 right-1 h-9 rounded-full bg-signal-500 px-4 text-sm font-semibold text-white transition-colors hover:bg-signal-600 lg:h-10 lg:px-5"
    >
      Ara
    </button>
  </form>

  <div
    class="search-panel absolute inset-x-0 top-[calc(100%+0.5rem)] z-30 hidden overflow-hidden rounded-2xl border border-steel-200 bg-white text-steel-900 shadow-[0_24px_60px_-16px_rgb(8_13_20/0.4)]"
    data-search-panel
  >
    <div class="p-4" data-search-popular>
      <p class="text-xs font-semibold text-steel-500">Popüler aramalar</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          POPULAR_SEARCHES.map((term) => (
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-full border border-steel-200 px-3 py-1.5 text-sm transition-colors hover:border-steel-900"
              data-search-chip={term}
            >
              <Icon name="TrendingUp" class="size-3.5 text-signal-500" />
              {term}
            </button>
          ))
        }
      </div>
    </div>
    <ul id={`${id}-liste`} role="listbox" aria-label="Arama önerileri" class="max-h-[60vh] overflow-y-auto py-2" data-search-list></ul>
    <p class="hidden px-5 py-6 text-sm text-steel-500" data-search-empty></p>
    <a
      href="/arama/"
      class="hidden items-center justify-between border-t border-steel-200 bg-galvanized px-5 py-3 text-sm font-semibold hover:text-signal-500"
      data-search-all
    >
      <span></span>
      <Icon name="CornerDownLeft" class="size-4 text-steel-500" />
    </a>
  </div>
</div>

<script>
  import type { SearchItem } from '../../lib/search-index';

  const normalize = (s: string) =>
    s
      .toLocaleLowerCase('tr')
      .replace(/ç/g, 'c').replace(/ğ/g, 'g').replace(/ı/g, 'i')
      .replace(/ö/g, 'o').replace(/ş/g, 's').replace(/ü/g, 'u')
      .replace(/[^a-z0-9× ]+/g, ' ')
      .trim();

  const indexEl = document.getElementById('arama-indeksi');
  const index: (SearchItem & { _name: string[]; _all: string[] })[] = indexEl
    ? (JSON.parse(indexEl.textContent || '[]') as SearchItem[]).map((item) => ({
        ...item,
        _name: normalize(item.name).split(/\s+/),
        _all: normalize(`${item.name} ${item.path} ${item.terms}`).split(/\s+/),
      }))
    : [];

  // "rafı" → "raf", "askılar" → "aski": kelime kökü yaklaşık eşleşmesi
  const wordMatch = (word: string, token: string) =>
    word.startsWith(token) || (word.length >= 3 && token.startsWith(word));

  const search = (query: string) => {
    const tokens = normalize(query).split(/\s+/).filter(Boolean);
    if (!tokens.length) return [];
    return index
      .map((item) => {
        if (!tokens.every((t) => item._all.some((w) => wordMatch(w, t)))) return null;
        // Puan: adda geçen her kelime +2, aranan kelimelerin hepsi adda geçiyorsa +3,
        // ad aranan bir kelimeyle başlıyorsa +2, ana kategori +1
        const inName = tokens.filter((t) => item._name.some((w) => wordMatch(w, t))).length;
        let score = inName * 2;
        if (inName === tokens.length) score += 3;
        if (tokens.some((t) => wordMatch(item._name[0] ?? '', t))) score += 2;
        if (item.path === 'Kategori') score += 1;
        return { item, score };
      })
      .filter((r): r is NonNullable<typeof r> => r !== null)
      .sort((a, b) => b.score - a.score)
      .slice(0, 7)
      .map((r) => r.item);
  };

  const escape = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  document.querySelectorAll<HTMLElement>('[data-search]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-search-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const panel = root.querySelector<HTMLElement>('[data-search-panel]')!;
    const popular = root.querySelector<HTMLElement>('[data-search-popular]')!;
    const list = root.querySelector<HTMLUListElement>('[data-search-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-search-empty]')!;
    const all = root.querySelector<HTMLAnchorElement>('[data-search-all]')!;
    let results: SearchItem[] = [];
    let active = -1;

    const open = () => {
      panel.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      panel.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };

    const setActive = (i: number) => {
      active = i;
      list.querySelectorAll('[role=option]').forEach((el, j) => el.setAttribute('aria-selected', String(j === i)));
      const el = list.querySelector<HTMLElement>(`[data-index="${i}"]`);
      input.setAttribute('aria-activedescendant', el?.id ?? '');
      el?.scrollIntoView({ block: 'nearest' });
    };

    const render = () => {
      const q = input.value.trim();
      results = search(q);
      popular.classList.toggle('hidden', q.length > 0);
      list.innerHTML = results
        .map(
          (r, i) => `
          <li id="${input.id}-oneri-${i}" role="option" aria-selected="false" data-index="${i}" class="aria-selected:[&>a]:bg-galvanized">
            <a href="${r.href}" tabindex="-1" class="flex items-center gap-3 px-3 mx-2 py-2 rounded-xl hover:bg-galvanized">
              <img src="${r.thumb}" alt="" width="44" height="44" class="size-11 shrink-0 rounded-lg border border-steel-200 bg-white object-contain p-0.5" loading="lazy" />
              <span class="min-w-0">
                <span class="block truncate font-semibold">${escape(r.name)}</span>
                <span class="block truncate text-xs text-steel-500">${escape(r.path)}</span>
              </span>
            </a>
          </li>`,
        )
        .join('');
      list.classList.toggle('hidden', !results.length);
      empty.classList.toggle('hidden', !q || results.length > 0);
      empty.textContent = q ? `"${q}" ile eşleşen kategori bulunamadı. Aradığınız ürünü WhatsApp'tan sorabilirsiniz.` : '';
      all.classList.toggle('hidden', !q);
      all.classList.toggle('flex', !!q);
      all.href = `/arama/?q=${encodeURIComponent(q)}`;
      all.querySelector('span')!.textContent = `"${q}" için tüm sonuçlar`;
      active = -1;
    };

    input.addEventListener('focus', () => {
      render();
      open();
    });
    input.addEventListener('input', () => {
      render();
      open();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && results.length) {
        e.preventDefault();
        setActive((active + 1) % results.length);
      } else if (e.key === 'ArrowUp' && results.length) {
        e.preventDefault();
        setActive((active - 1 + results.length) % results.length);
      } else if (e.key === 'Escape') {
        close();
        input.blur();
      }
    });

    // Seçili öneri varsa ona git, yoksa tam eşleşen kategoriye, o da yoksa arama sayfasına
    form.addEventListener('submit', (e) => {
      const pick = active >= 0 ? results[active] : results.find((r) => normalize(r.name) === normalize(input.value));
      if (pick) {
        e.preventDefault();
        window.location.href = pick.href;
      }
    });

    root.querySelectorAll<HTMLButtonElement>('[data-search-chip]').forEach((chip) =>
      chip.addEventListener('click', () => {
        input.value = chip.dataset.searchChip!;
        input.focus();
        render();
      }),
    );

    document.addEventListener('pointerdown', (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    if ('hotkey' in root.dataset) {
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName) && !t.isContentEditable) {
          e.preventDefault();
          input.focus();
        }
      });
    }
  });
</script>
