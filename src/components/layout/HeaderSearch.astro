---
// Anlık önerili arama: kategoriler + ürünler (katalog no ile de aranabilir).
// Veri /katalog.json'dan ilk odakta indirilir. Header'da (masaüstü) ve mobil ikinci satırda kullanılır.
import Icon from '../ui/Icon.astro';
import { POPULAR_SEARCHES } from '../../lib/search-index';

export interface Props {
  id: string;
  class?: string;
  /** "/" kısayolu sadece masaüstü örneğinde aktif */
  hotkey?: boolean;
}

const { id, class: className, hotkey = false } = Astro.props;
---

<div class:list={['header-search relative', className]} data-search data-hotkey={hotkey ? '' : undefined}>
  <form action="/arama/" method="get" role="search" class="relative" data-search-form>
    <label for={id} class="sr-only">Ürün, kategori veya katalog no ara</label>
    <Icon
      name="Search"
      class="pointer-events-none absolute top-1/2 left-4 size-4.5 -translate-y-1/2 text-steel-500"
    />
    <input
      id={id}
      name="q"
      type="search"
      placeholder="Ürün, kategori veya katalog no ara…"
      autocomplete="off"
      spellcheck="false"
      role="combobox"
      aria-expanded="false"
      aria-controls={`${id}-liste`}
      aria-autocomplete="list"
      class="peer h-11 w-full rounded-full border border-transparent bg-white pr-24 pl-11 text-base text-steel-900 shadow-[inset_0_0_0_1px_var(--color-steel-200)] transition-shadow outline-none placeholder:text-steel-500 focus:shadow-[inset_0_0_0_2px_var(--color-signal-500)] lg:h-12 lg:text-[0.95rem] [&::-webkit-search-cancel-button]:hidden"
      data-search-input
    />
    {
      hotkey && (
        <kbd
          class="pointer-events-none absolute top-1/2 right-20 hidden -translate-y-1/2 rounded-md border border-steel-200 px-1.5 text-xs font-medium text-steel-500 peer-focus:hidden peer-[:not(:placeholder-shown)]:hidden xl:block"
          aria-hidden="true"
        >
          /
        </kbd>
      )
    }
    <button
      type="submit"
      class="absolute top-1 right-1 h-9 rounded-full bg-signal-500 px-4 text-sm font-semibold text-white transition-colors hover:bg-signal-600 lg:h-10 lg:px-5"
    >
      Ara
    </button>
  </form>

  <div
    class="search-panel absolute inset-x-0 top-[calc(100%+0.5rem)] z-30 hidden overflow-hidden rounded-2xl border border-steel-200 bg-white text-steel-900 shadow-[0_24px_60px_-16px_rgb(8_13_20/0.4)]"
    data-search-panel
  >
    <div class="p-4" data-search-popular>
      <p class="text-xs font-semibold text-steel-500">Popüler aramalar</p>
      <div class="mt-3 flex flex-wrap gap-2">
        {
          POPULAR_SEARCHES.map((term) => (
            <button
              type="button"
              class="inline-flex items-center gap-1.5 rounded-full border border-steel-200 px-3 py-1.5 text-sm transition-colors hover:border-steel-900"
              data-search-chip={term}
            >
              <Icon name="TrendingUp" class="size-3.5 text-signal-500" />
              {term}
            </button>
          ))
        }
      </div>
    </div>
    <div
      id={`${id}-liste`}
      role="listbox"
      aria-label="Arama önerileri"
      class="max-h-[min(60vh,32rem)] overflow-y-auto"
      data-search-list
    >
    </div>
    <p class="hidden px-5 py-6 text-sm text-steel-500" data-search-empty></p>
    <a
      href="/arama/"
      class="hidden items-center justify-between border-t border-steel-200 bg-galvanized px-5 py-3 text-sm font-semibold hover:text-signal-500"
      data-search-all
    >
      <span></span>
      <Icon name="CornerDownLeft" class="size-4 text-steel-500" />
    </a>
  </div>
</div>

<script>
  import type { CatalogData, CatalogProduct, SearchCategory } from '../../lib/search-index';
  import { loadCatalog, normalize, wordMatch, matchesAll, escapeHtml } from '../../scripts/catalog-client';

  type Indexed<T> = T & { _name: string[]; _all: string[] };
  type Option = { href: string };
  let index: { categories: Indexed<SearchCategory>[]; products: Indexed<CatalogProduct>[] } | undefined;

  const words = (s: string) => normalize(s).split(' ').filter(Boolean);
  const buildIndex = (data: CatalogData) => ({
    categories: data.categories.map((c) => ({ ...c, _name: words(c.name), _all: words(`${c.name} ${c.path} ${c.terms}`) })),
    products: data.products.map((p) => ({
      ...p,
      _name: words(p.name),
      _all: words(`${p.name} ${p.code} ${p.cat} ${Object.values(p.attrs).join(' ')}`),
    })),
  });

  // Puan: adda geçen her kelime +2, aranan kelimelerin hepsi adda geçiyorsa +3,
  // ad aranan bir kelimeyle başlıyorsa +2; katalog no ile başlayan ürün +10
  function score(item: { _name: string[] }, tokens: string[]) {
    const inName = tokens.filter((t) => item._name.some((w) => wordMatch(w, t))).length;
    let s = inName * 2;
    if (inName === tokens.length) s += 3;
    if (tokens.some((t) => wordMatch(item._name[0] ?? '', t))) s += 2;
    return s;
  }
  function rank<T extends { _name: string[]; _all: string[] }>(
    items: T[],
    tokens: string[],
    limit: number,
    codeOf?: (i: T) => string,
  ) {
    const q = tokens.join(' ');
    return items
      .filter((i) => matchesAll(i._all, tokens))
      .map((i) => ({ i, s: score(i, tokens) + (codeOf && normalize(codeOf(i)).startsWith(q) ? 10 : 0) }))
      .sort((a, b) => b.s - a.s)
      .slice(0, limit)
      .map((r) => r.i);
  }

  document.querySelectorAll<HTMLElement>('[data-search]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-search-form]')!;
    const input = root.querySelector<HTMLInputElement>('[data-search-input]')!;
    const panel = root.querySelector<HTMLElement>('[data-search-panel]')!;
    const popular = root.querySelector<HTMLElement>('[data-search-popular]')!;
    const list = root.querySelector<HTMLElement>('[data-search-list]')!;
    const empty = root.querySelector<HTMLElement>('[data-search-empty]')!;
    const all = root.querySelector<HTMLAnchorElement>('[data-search-all]')!;
    let options: Option[] = [];
    let active = -1;

    const open = () => {
      panel.classList.remove('hidden');
      input.setAttribute('aria-expanded', 'true');
    };
    const close = () => {
      panel.classList.add('hidden');
      input.setAttribute('aria-expanded', 'false');
      active = -1;
    };

    const setActive = (i: number) => {
      active = i;
      list.querySelectorAll('[role=option]').forEach((el, j) => el.setAttribute('aria-selected', String(j === i)));
      const el = list.querySelector<HTMLElement>(`[data-index="${i}"]`);
      input.setAttribute('aria-activedescendant', el?.id ?? '');
      el?.scrollIntoView({ block: 'nearest' });
    };

    const optionHtml = (i: number, opt: Option, thumb: string, title: string, sub: string, cover = false) => `
      <div id="${input.id}-oneri-${i}" role="option" aria-selected="false" data-index="${i}" class="aria-selected:[&>a]:bg-galvanized">
        <a href="${opt.href}" tabindex="-1" class="mx-2 flex items-center gap-3 rounded-xl px-3 py-2 hover:bg-galvanized">
          <img src="${thumb}" alt="" width="44" height="44" loading="lazy" class="size-11 shrink-0 rounded-lg border border-steel-200 bg-white ${cover ? 'object-cover' : 'object-contain p-0.5'}" />
          <span class="min-w-0">
            <span class="block truncate font-semibold">${escapeHtml(title)}</span>
            <span class="block truncate text-xs text-steel-500">${escapeHtml(sub)}</span>
          </span>
        </a>
      </div>`;
    const heading = (text: string) =>
      `<p class="px-5 pt-3 pb-1 text-xs font-semibold text-steel-500" role="presentation">${text}</p>`;

    const render = () => {
      const q = input.value.trim();
      const tokens = words(q);
      popular.classList.toggle('hidden', q.length > 0);
      all.classList.toggle('hidden', !q);
      all.classList.toggle('flex', !!q);
      all.href = `/arama/?q=${encodeURIComponent(q)}`;
      all.querySelector('span')!.textContent = `"${q}" için tüm sonuçlar`;
      active = -1;

      if (!index || !tokens.length) {
        list.innerHTML = q && !index ? '<p class="px-5 py-4 text-sm text-steel-500">Yükleniyor…</p>' : '';
        options = [];
        empty.classList.add('hidden');
        return;
      }

      const cats = rank(index.categories, tokens, 3);
      const prods = rank(index.products, tokens, 6, (p) => p.code);
      const catOptions: Option[] = cats.map((c) => ({ href: c.href }));
      const prodOptions: Option[] = prods.map((p) => ({ href: p.href }));
      options = [...catOptions, ...prodOptions];

      let html = '';
      if (cats.length) {
        html += heading('Kategoriler');
        html += cats.map((c, i) => optionHtml(i, catOptions[i], c.thumb, c.name, `${c.path} · ${c.count} ürün`)).join('');
      }
      if (prods.length) {
        html += heading('Ürünler');
        html += prods
          .map((p, j) =>
            optionHtml(cats.length + j, prodOptions[j], p.thumb, p.name, `${p.cat} · ${p.code}`, p.fit === 'cover'),
          )
          .join('');
      }
      list.innerHTML = html + (options.length ? '<div class="h-2"></div>' : '');
      empty.classList.toggle('hidden', options.length > 0);
      empty.textContent = `"${q}" ile eşleşen ürün bulunamadı. Aradığınız ürünü WhatsApp'tan sorabilirsiniz.`;
    };

    const ensureIndex = () => {
      if (index) return;
      loadCatalog()
        .then((data) => {
          index ??= buildIndex(data);
          render();
        })
        .catch(() => {
          list.innerHTML = '<p class="px-5 py-4 text-sm text-steel-500">Öneriler yüklenemedi. Ara butonuyla arama yapabilirsiniz.</p>';
        });
    };

    input.addEventListener('focus', () => {
      ensureIndex();
      render();
      open();
    });
    input.addEventListener('input', () => {
      render();
      open();
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown' && options.length) {
        e.preventDefault();
        setActive((active + 1) % options.length);
      } else if (e.key === 'ArrowUp' && options.length) {
        e.preventDefault();
        setActive((active - 1 + options.length) % options.length);
      } else if (e.key === 'Escape') {
        close();
        input.blur();
      }
    });

    // Seçili öneri varsa ona git; seçim yoksa form arama sayfasına gider
    form.addEventListener('submit', (e) => {
      const opt = options[active];
      if (!opt) return;
      e.preventDefault();
      window.location.href = opt.href;
    });

    root.querySelectorAll<HTMLButtonElement>('[data-search-chip]').forEach((chip) =>
      chip.addEventListener('click', () => {
        input.value = chip.dataset.searchChip!;
        input.focus();
        render();
      }),
    );

    document.addEventListener('pointerdown', (e) => {
      if (!root.contains(e.target as Node)) close();
    });

    if ('hotkey' in root.dataset) {
      document.addEventListener('keydown', (e) => {
        const t = e.target as HTMLElement;
        if (e.key === '/' && !['INPUT', 'TEXTAREA', 'SELECT'].includes(t.tagName) && !t.isContentEditable) {
          e.preventDefault();
          input.focus();
        }
      });
    }
  });
</script>
