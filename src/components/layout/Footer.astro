---
// Footer: marka + sosyal medya, ürün ve kurumsal linkler, iletişim, konum haritası.
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import { CATEGORIES, categoryHref } from '../../data/categories';
import { CONTACT, SITE, fullAddress, whatsappLink } from '../../config/site';

const corporate = [
  { name: 'Hakkımızda', href: '/hakkimizda/' },
  { name: 'Projeler', href: '/projeler/' },
  { name: 'Blog', href: '/blog/' },
  { name: 'Sıkça sorulan sorular', href: '/#sss' },
  { name: 'İletişim', href: '/iletisim/' },
];

const socials = (
  [
    { name: 'instagram', label: 'Instagram', href: CONTACT.social.instagram },
    { name: 'facebook', label: 'Facebook', href: CONTACT.social.facebook },
    { name: 'youtube', label: 'YouTube', href: CONTACT.social.youtube },
  ] as const
).filter((s) => s.href);

const address = fullAddress();
const mapEmbed = CONTACT.map.embed;
const mapLink = CONTACT.map.directions;
const year = new Date().getFullYear();
---

<footer class="bg-steel-950 text-steel-300">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8 lg:py-20">
    <div class="lg:col-span-3">
      <Logo width={188} loading="lazy" class="w-47" />
      <p class="mt-6 max-w-xs text-sm leading-relaxed">
        Mağaza içi raf, orta sistem ve stand üretiminde tasarımdan montaja anahtar teslim çözümler.
      </p>
      <ul class="mt-6 flex gap-2" role="list" aria-label="Sosyal medya">
        {
          socials.map((s) => (
            <li>
              <a
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={s.label}
                class="grid size-10 place-items-center rounded-full border border-white/15 text-white transition-colors hover:border-white/50"
              >
                <BrandIcon name={s.name} class="size-4" />
              </a>
            </li>
          ))
        }
        <li>
          <a
            href={whatsappLink()}
            target="_blank"
            rel="noopener"
            aria-label="WhatsApp"
            class="grid size-10 place-items-center rounded-full bg-whatsapp text-steel-950 transition-colors hover:bg-whatsapp-dark hover:text-white"
          >
            <BrandIcon name="whatsapp" class="size-4.5" />
          </a>
        </li>
      </ul>
    </div>

    <nav aria-labelledby="footer-urunler" class="lg:col-span-2">
      <h2 id="footer-urunler" class="text-sm font-bold text-white">Ürünler</h2>
      <ul class="mt-5 space-y-3 text-sm" role="list">
        {
          CATEGORIES.map((cat) => (
            <li>
              <a href={categoryHref(cat.slug)} class="transition-colors hover:text-white">
                {cat.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav aria-labelledby="footer-kurumsal" class="lg:col-span-2">
      <h2 id="footer-kurumsal" class="text-sm font-bold text-white">Kurumsal</h2>
      <ul class="mt-5 space-y-3 text-sm" role="list">
        {
          corporate.map((item) => (
            <li>
              <a href={item.href} class="transition-colors hover:text-white">
                {item.name}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lg:col-span-2">
      <h2 class="text-sm font-bold text-white">İletişim</h2>
      <address class="mt-5 space-y-3 text-sm not-italic">
        <p class="flex gap-3">
          <Icon name="MapPin" class="mt-0.5 size-4 shrink-0 text-signal-500" />
          {address}
        </p>
        {
          CONTACT.phones.map((phone) => (
            <p class="flex gap-3">
              <Icon name="Phone" class="mt-0.5 size-4 shrink-0 text-signal-500" />
              <a href={`tel:${phone.tel}`} class="whitespace-nowrap transition-colors hover:text-white">
                {phone.display}
              </a>
            </p>
          ))
        }
        <p class="flex gap-3">
          <Icon name="Mail" class="mt-0.5 size-4 shrink-0 text-signal-500" />
          <a href={`mailto:${CONTACT.email}`} class="transition-colors hover:text-white">
            {CONTACT.email.split('@')[0]}@<wbr />{CONTACT.email.split('@')[1]}
          </a>
        </p>
        <p class="flex gap-3">
          <Icon name="Clock" class="mt-0.5 size-4 shrink-0 text-signal-500" />
          {CONTACT.hours.label}
        </p>
      </address>
    </div>

    <div class="sm:col-span-2 lg:col-span-3">
      <h2 class="text-sm font-bold text-white">Konum</h2>
      <div class="mt-5 overflow-hidden rounded-2xl border border-white/10">
        <iframe
          src={mapEmbed}
          title={`${SITE.name} konum haritası`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="block aspect-4/3 w-full grayscale-[35%]"></iframe>
      </div>
      <a
        href={mapLink}
        target="_blank"
        rel="noopener"
        class="mt-3 inline-flex items-center gap-1.5 text-sm font-semibold text-white hover:text-signal-500"
      >
        Yol tarifi al
        <Icon name="ArrowUpRight" class="size-4" />
      </a>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-page flex flex-col gap-3 py-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name}. Tüm hakları saklıdır.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2" role="list">
        <li><a href="/kvkk/" class="hover:text-white">KVKK Aydınlatma Metni</a></li>
        <li><a href="/cerez-politikasi/" class="hover:text-white">Çerez Politikası</a></li>
        <li><a href="/urunler/" class="hover:text-white">Tüm ürünler</a></li>
      </ul>
    </div>
  </div>
</footer>
