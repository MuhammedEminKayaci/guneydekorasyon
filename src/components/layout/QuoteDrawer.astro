---
// Teklif paneli: teklif listesindeki ürünler (adetleriyle) + iletişim formu.
// Liste boşsa genel teklif formu olarak çalışır. Sitede form sunucusu olmadığından bilgiler
// hazır bir WhatsApp mesajına dönüştürülür ve firmanın hattında açılır.
// Açmak için: [data-quote-open] olan herhangi bir buton veya "teklif:ac" olayı.
import Icon from '../ui/Icon.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import { CATEGORIES } from '../../data/categories';
import { CONTACT } from '../../config/site';
---

<dialog
  id="teklif-paneli"
  class="quote-drawer m-0 ml-auto h-dvh max-h-none w-full max-w-md overflow-hidden bg-white p-0 text-steel-900 backdrop:bg-steel-950/60 backdrop:backdrop-blur-sm"
  aria-labelledby="teklif-paneli-baslik"
>
  <form class="flex h-full flex-col" data-quote-form novalidate>
    <div class="flex h-16 shrink-0 items-center justify-between border-b border-steel-200 px-5">
      <h2 id="teklif-paneli-baslik" class="flex items-center gap-2 text-lg font-bold">
        Teklif listesi
        <span class="grid h-6 min-w-6 place-items-center rounded-full bg-signal-500 px-1.5 text-xs text-white" data-quote-count>0</span>
      </h2>
      <button type="button" class="-mr-2 grid size-10 place-items-center rounded-full hover:bg-galvanized" aria-label="Kapat" data-quote-close>
        <Icon name="X" class="size-5" />
      </button>
    </div>

    <div class="flex-1 overflow-y-auto overscroll-contain">
      <!-- Boş liste -->
      <div class="hidden px-5 pt-6" data-quote-empty>
        <div class="rounded-2xl bg-galvanized p-5">
          <p class="font-semibold">Listeniz henüz boş</p>
          <p class="mt-1 text-sm text-steel-500">
            Ürün kartlarındaki <span class="inline-grid size-5 translate-y-0.5 place-items-center rounded-full bg-white align-baseline"><Icon name="Plus" class="size-3" /></span>
            butonuyla modelleri listeye ekleyebilir ya da aşağıya genel talebinizi yazabilirsiniz.
          </p>
          <a href="/urunler/" class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-signal-500 hover:text-signal-600">
            Ürünleri inceleyin
            <Icon name="ArrowRight" class="size-4" />
          </a>
        </div>
      </div>

      <!-- Liste -->
      <ul class="divide-y divide-steel-200 px-5" data-quote-items role="list"></ul>
      <div class="hidden px-5 pb-2 text-right" data-quote-clear-wrap>
        <button type="button" class="text-sm font-medium text-steel-500 underline-offset-4 hover:text-signal-500 hover:underline" data-quote-clear>
          Listeyi temizle
        </button>
      </div>

      <!-- İletişim bilgileri -->
      <fieldset class="mt-4 border-t border-steel-200 px-5 pt-5 pb-6">
        <legend class="sr-only">İletişim bilgileriniz</legend>
        <p class="font-semibold">Bilgileriniz</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <label class="field">
            <span>Ad soyad</span>
            <input name="ad" type="text" required autocomplete="name" />
          </label>
          <label class="field">
            <span>Telefon</span>
            <input name="telefon" type="tel" required autocomplete="tel" inputmode="tel" />
          </label>
          <label class="field" data-quote-topic>
            <span>İlgilendiğiniz ürün</span>
            <select name="urun">
              <option value="Komple mağaza dekorasyonu">Komple mağaza dekorasyonu</option>
              {CATEGORIES.map((cat) => <option value={cat.name}>{cat.name}</option>)}
            </select>
          </label>
          <label class="field">
            <span>Şehir</span>
            <input name="sehir" type="text" autocomplete="address-level2" />
          </label>
          <label class="field sm:col-span-2">
            <span>Not <span class="font-normal text-steel-500">(isteğe bağlı)</span></span>
            <textarea name="mesaj" rows="3" placeholder="Mağaza ölçüsü, renk tercihi, istediğiniz tarih…"></textarea>
          </label>
        </div>
        <p class="mt-4 hidden text-sm font-medium text-signal-600" role="alert" data-quote-error>
          Ad soyad ve telefon alanlarını doldurun.
        </p>
      </fieldset>
    </div>

    <div class="shrink-0 border-t border-steel-200 bg-white p-5">
      <button type="submit" class="btn-whatsapp w-full rounded-full">
        <BrandIcon name="whatsapp" class="size-5" />
        <span data-quote-submit-label>WhatsApp ile gönder</span>
      </button>
      <p class="mt-3 text-center text-sm text-steel-500">
        ya da arayın:
        <a href={`tel:${CONTACT.phones[0].tel}`} class="font-semibold text-steel-900 hover:text-signal-500">
          {CONTACT.phones[0].display}
        </a>
      </p>
    </div>
  </form>
</dialog>

<!-- Ekleme bildirimi -->
<div
  class="quote-toast pointer-events-none fixed inset-x-4 bottom-24 z-[70] mx-auto flex max-w-sm items-center gap-3 rounded-2xl bg-steel-950 px-4 py-3 text-sm text-white opacity-0 shadow-2xl lg:bottom-8"
  role="status"
  aria-live="polite"
  data-quote-toast
>
  <Icon name="CircleCheck" class="size-5 shrink-0 text-whatsapp" />
  <span class="flex-1" data-quote-toast-text></span>
  <button type="button" class="pointer-events-auto font-semibold text-white underline underline-offset-4" data-quote-open>
    Listeyi gör
  </button>
</div>

<style>
  .field {
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid var(--color-steel-200);
    border-radius: 0.75rem;
    background: var(--color-galvanized);
    padding: 0.7rem 0.9rem;
    font-size: 1rem;
    font-weight: 400;
    outline: none;
    transition: border-color 150ms;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--color-steel-500);
    background: white;
  }
  .field [aria-invalid='true'] {
    border-color: var(--color-signal-500);
  }
  .quote-drawer[open] {
    animation: drawer-in 280ms var(--ease-out-quart);
  }
  @keyframes drawer-in {
    from {
      transform: translateX(100%);
    }
  }
  .quote-toast {
    transform: translateY(0.75rem);
    transition:
      opacity 200ms,
      transform 250ms var(--ease-out-quart);
  }
  .quote-toast[data-visible] {
    opacity: 1;
    transform: none;
  }
</style>

<script>
  import { CONTACT } from '../../config/site';
  import { escapeHtml } from '../../scripts/catalog-client';
  import * as quote from '../../scripts/quote-list';

  const drawer = document.getElementById('teklif-paneli') as HTMLDialogElement;
  const form = drawer.querySelector<HTMLFormElement>('[data-quote-form]')!;
  const itemsEl = drawer.querySelector<HTMLUListElement>('[data-quote-items]')!;
  const emptyEl = drawer.querySelector<HTMLElement>('[data-quote-empty]')!;
  const clearWrap = drawer.querySelector<HTMLElement>('[data-quote-clear-wrap]')!;
  const topic = drawer.querySelector<HTMLElement>('[data-quote-topic]')!;
  const error = drawer.querySelector<HTMLElement>('[data-quote-error]')!;
  const submitLabel = drawer.querySelector<HTMLElement>('[data-quote-submit-label]')!;
  const toast = document.querySelector<HTMLElement>('[data-quote-toast]')!;
  const toastText = toast.querySelector<HTMLElement>('[data-quote-toast-text]')!;

  const open = () => {
    document.querySelectorAll<HTMLDialogElement>('dialog[open]').forEach((d) => d !== drawer && d.close());
    render();
    drawer.showModal();
  };

  function render() {
    const items = quote.getItems();
    const n = items.length;
    document.querySelectorAll('[data-quote-count]').forEach((el) => {
      el.textContent = String(n);
      el.classList.toggle('invisible', n === 0 && el.hasAttribute('data-hide-empty'));
    });
    emptyEl.classList.toggle('hidden', n > 0);
    clearWrap.classList.toggle('hidden', n === 0);
    topic.hidden = n > 0;
    submitLabel.textContent = n ? `${n} ürün için WhatsApp ile gönder` : 'WhatsApp ile gönder';
    itemsEl.innerHTML = items
      .map(
        (i) => `
        <li class="flex gap-3 py-4" data-id="${i.id}">
          <img src="${i.thumb}" alt="" width="64" height="64" class="size-16 shrink-0 rounded-xl border border-steel-200 bg-white object-contain p-1" />
          <div class="min-w-0 flex-1">
            ${i.href ? `<a href="${i.href}" class="font-semibold leading-snug hover:text-signal-500">${escapeHtml(i.name)}</a>` : `<p class="font-semibold leading-snug">${escapeHtml(i.name)}</p>`}
            <p class="mt-0.5 text-xs text-steel-500">Katalog no: ${escapeHtml(i.code)}</p>
            <div class="mt-2 flex items-center justify-between gap-3">
              <div class="inline-flex items-center rounded-full border border-steel-200">
                <button type="button" class="grid size-8 place-items-center rounded-full hover:bg-galvanized" data-qty-step="-1" aria-label="Adedi azalt">−</button>
                <input type="number" min="1" max="99999" value="${i.qty}" inputmode="numeric" class="w-14 [appearance:textfield] bg-transparent text-center text-sm font-semibold outline-none [&::-webkit-inner-spin-button]:appearance-none" aria-label="${escapeHtml(i.name)} adedi" data-qty-input />
                <button type="button" class="grid size-8 place-items-center rounded-full hover:bg-galvanized" data-qty-step="1" aria-label="Adedi artır">+</button>
              </div>
              <button type="button" class="text-sm text-steel-500 hover:text-signal-500" data-remove>Kaldır</button>
            </div>
          </div>
        </li>`,
      )
      .join('');
  }

  // Liste içi işlemler
  itemsEl.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const li = t.closest<HTMLElement>('li[data-id]');
    if (!li) return;
    const id = li.dataset.id!;
    if (t.closest('[data-remove]')) quote.remove(id);
    const step = t.closest<HTMLElement>('[data-qty-step]');
    if (step) {
      const item = quote.getItems().find((i) => i.id === id);
      if (item) quote.setQty(id, item.qty + Number(step.dataset.qtyStep));
    }
  });
  itemsEl.addEventListener('change', (e) => {
    const input = (e.target as HTMLElement).closest<HTMLInputElement>('[data-qty-input]');
    const li = input?.closest<HTMLElement>('li[data-id]');
    if (input && li) quote.setQty(li.dataset.id!, Number(input.value));
  });
  drawer.querySelector('[data-quote-clear]')!.addEventListener('click', () => quote.clear());

  // Açma/kapama
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-quote-open]')) {
      e.preventDefault();
      hideToast();
      open();
    }
  });
  document.addEventListener('teklif:ac', open);
  drawer.querySelector('[data-quote-close]')!.addEventListener('click', () => drawer.close());
  drawer.addEventListener('click', (e) => {
    if (e.target === drawer) drawer.close();
  });

  // Değişiklikleri yansıt + ekleme bildirimi
  let toastTimer: number | undefined;
  const hideToast = () => toast.removeAttribute('data-visible');
  let lastCount = quote.getItems().length;
  document.addEventListener(quote.CHANGE_EVENT, () => {
    const n = quote.getItems().length;
    if (n > lastCount && !drawer.open) {
      const added = quote.getItems().at(-1)!;
      toastText.textContent = `${added.name} teklif listesine eklendi.`;
      toast.setAttribute('data-visible', '');
      window.clearTimeout(toastTimer);
      toastTimer = window.setTimeout(hideToast, 3500);
    }
    lastCount = n;
    render();
  });

  // Ürün kartlarındaki "teklif listesine ekle" butonları
  const syncCardButtons = () => {
    document.querySelectorAll<HTMLButtonElement>('[data-add-quote]').forEach((btn) => {
      const card = btn.closest<HTMLElement>('[data-product]');
      const inList = !!card && quote.has(card.dataset.id!);
      btn.setAttribute('aria-pressed', String(inList));
      btn.title = inList ? 'Teklif listesinden çıkar' : 'Teklif listesine ekle';
    });
  };
  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-add-quote]');
    const card = btn?.closest<HTMLElement>('[data-product]');
    if (!btn || !card) return;
    const { id, name, code, href } = card.dataset;
    quote.toggle({ id: id!, name: name!, code: code!, thumb: btn.dataset.thumb!, href });
  });
  document.addEventListener(quote.CHANGE_EVENT, syncCardButtons);
  syncCardButtons();

  // Gönder
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? '').trim();
    const required = ['ad', 'telefon'].map((k) => form.elements.namedItem(k) as HTMLInputElement);
    required.forEach((el) => el.setAttribute('aria-invalid', String(!el.value.trim())));
    const missing = required.find((el) => !el.value.trim());
    if (missing) {
      error.classList.remove('hidden');
      missing.focus();
      return;
    }
    error.classList.add('hidden');

    const items = quote.getItems();
    const lines = ['Merhaba, web sitenizden teklif almak istiyorum.', ''];
    if (items.length) {
      lines.push('Ürünler:');
      items.forEach((i) => lines.push(`• ${i.name} (${i.code}): ${i.qty} adet`));
      lines.push('');
    } else {
      lines.push(`Konu: ${get('urun')}`);
    }
    lines.push(`Ad soyad: ${get('ad')}`, `Telefon: ${get('telefon')}`);
    if (get('sehir')) lines.push(`Şehir: ${get('sehir')}`);
    if (get('mesaj')) lines.push(`Not: ${get('mesaj')}`);

    window.open(`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(lines.join('\n'))}`, '_blank', 'noopener');
  });

  render();
</script>
