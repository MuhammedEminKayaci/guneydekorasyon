---
// Telefonda ekranın altında sabit eylem çubuğu: Ara, WhatsApp, Ürünler, Teklif (liste sayısıyla).
import Icon from '../ui/Icon.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import { CONTACT, whatsappLink } from '../../config/site';

const item = 'flex flex-1 flex-col items-center justify-center gap-1 py-2 text-[0.7rem] font-semibold';
---

<nav
  class="fixed inset-x-0 bottom-0 z-40 border-t border-steel-200 bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden"
  aria-label="Hızlı erişim"
>
  <div class="flex h-16 items-stretch">
    <a href={`tel:${CONTACT.phones[0].tel}`} class:list={[item, 'text-steel-900']}>
      <Icon name="Phone" class="size-5" />
      Ara
    </a>
    <a href={whatsappLink()} target="_blank" rel="noopener" class:list={[item, 'text-whatsapp-dark']}>
      <BrandIcon name="whatsapp" class="size-5" />
      WhatsApp
    </a>
    <a href="/urunler/" class:list={[item, 'text-steel-900']}>
      <Icon name="LayoutGrid" class="size-5" />
      Ürünler
    </a>
    <button type="button" class:list={[item, 'relative text-signal-500']} data-quote-open>
      <span class="relative">
        <Icon name="FileText" class="size-5" />
        <span
          class="absolute -top-2 -right-3 grid h-4.5 min-w-4.5 place-items-center rounded-full bg-signal-500 px-1 text-[0.65rem] leading-none text-white"
          data-quote-count
          data-hide-empty>0</span
        >
      </span>
      Teklif
    </button>
  </div>
</nav>
