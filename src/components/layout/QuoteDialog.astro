---
// "Teklif Al" penceresi. Sitede form sunucusu olmadığı için bilgiler hazır bir WhatsApp mesajına
// dönüştürülür ve firmanın WhatsApp hattında açılır. Mesaj kaybolmaz, doğrudan firmaya gider.
import Icon from '../ui/Icon.astro';
import BrandIcon from '../ui/BrandIcon.astro';
import { CATEGORIES } from '../../data/categories';
import { CONTACT } from '../../config/site';
---

<dialog
  id="teklif-al"
  class="quote-dialog m-auto w-[calc(100%-2rem)] max-w-lg rounded-3xl bg-white p-0 text-steel-900 shadow-2xl backdrop:bg-steel-950/70 backdrop:backdrop-blur-sm"
  aria-labelledby="teklif-al-baslik"
>
  <form method="dialog" class="p-6 sm:p-8" data-quote-form novalidate>
    <div class="flex items-start justify-between gap-4">
      <div>
        <h2 id="teklif-al-baslik" class="text-2xl font-bold">Teklif alın</h2>
        <p class="mt-1 text-sm text-steel-500">
          Bilgileri doldurun, mesajınız WhatsApp üzerinden doğrudan bize ulaşsın.
        </p>
      </div>
      <button
        type="button"
        class="-mt-1 -mr-2 grid size-10 shrink-0 place-items-center rounded-full hover:bg-galvanized"
        aria-label="Kapat"
        data-quote-close
      >
        <Icon name="X" class="size-5" />
      </button>
    </div>

    <div class="mt-6 grid gap-4 sm:grid-cols-2">
      <label class="field">
        <span>Ad soyad</span>
        <input name="ad" type="text" required autocomplete="name" />
      </label>
      <label class="field">
        <span>Telefon</span>
        <input name="telefon" type="tel" required autocomplete="tel" inputmode="tel" />
      </label>
      <label class="field">
        <span>İlgilendiğiniz ürün</span>
        <select name="urun">
          <option value="Mağaza dekorasyonu (komple)">Komple mağaza dekorasyonu</option>
          {CATEGORIES.map((cat) => <option value={cat.name}>{cat.name}</option>)}
        </select>
      </label>
      <label class="field">
        <span>Şehir</span>
        <input name="sehir" type="text" autocomplete="address-level2" />
      </label>
      <label class="field sm:col-span-2">
        <span>Mesajınız <span class="font-normal text-steel-500">(isteğe bağlı)</span></span>
        <textarea name="mesaj" rows="3" placeholder="Mağaza ölçüsü, adet, istediğiniz tarih…"></textarea>
      </label>
    </div>

    <p class="mt-4 hidden text-sm font-medium text-signal-600" role="alert" data-quote-error>
      Ad soyad ve telefon alanlarını doldurun.
    </p>

    <button type="submit" class="btn-whatsapp mt-6 w-full rounded-full">
      <BrandIcon name="whatsapp" class="size-5" />
      WhatsApp ile gönder
    </button>
    <p class="mt-3 text-center text-sm text-steel-500">
      ya da arayın:
      <a href={`tel:${CONTACT.phones[0].tel}`} class="font-semibold text-steel-900 hover:text-signal-500">
        {CONTACT.phones[0].display}
      </a>
    </p>
  </form>
</dialog>

<style>
  .field {
    display: grid;
    gap: 0.375rem;
    font-size: 0.875rem;
    font-weight: 600;
  }
  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid var(--color-steel-200);
    border-radius: 0.75rem;
    background: var(--color-galvanized);
    padding: 0.75rem 1rem;
    font-size: 1rem;
    font-weight: 400;
    outline: none;
    transition: border-color 150ms;
  }
  .field input:focus,
  .field select:focus,
  .field textarea:focus {
    border-color: var(--color-steel-500);
    background: white;
  }
  .field [aria-invalid='true'] {
    border-color: var(--color-signal-500);
  }
  .quote-dialog[open] {
    animation: quote-in 240ms var(--ease-out-quart);
  }
  @keyframes quote-in {
    from {
      opacity: 0;
      transform: translateY(1rem) scale(0.98);
    }
  }
</style>

<script>
  import { CONTACT } from '../../config/site';

  const dialog = document.getElementById('teklif-al') as HTMLDialogElement;
  const form = dialog.querySelector<HTMLFormElement>('[data-quote-form]')!;
  const error = dialog.querySelector<HTMLElement>('[data-quote-error]')!;

  document.querySelectorAll('[data-quote-open]').forEach((btn) =>
    btn.addEventListener('click', () => {
      (document.getElementById('mobil-menu') as HTMLDialogElement | null)?.close();
      dialog.showModal();
    }),
  );
  dialog.querySelector('[data-quote-close]')?.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const data = new FormData(form);
    const get = (k: string) => String(data.get(k) ?? '').trim();

    const required = ['ad', 'telefon'].map((k) => form.elements.namedItem(k) as HTMLInputElement);
    required.forEach((el) => el.setAttribute('aria-invalid', String(!el.value.trim())));
    const missing = required.find((el) => !el.value.trim());
    if (missing) {
      error.classList.remove('hidden');
      missing.focus();
      return;
    }
    error.classList.add('hidden');

    const details = [
      `Ad soyad: ${get('ad')}`,
      `Telefon: ${get('telefon')}`,
      `Ürün: ${get('urun')}`,
      get('sehir') ? `Şehir: ${get('sehir')}` : '',
      get('mesaj') ? `Not: ${get('mesaj')}` : '',
    ].filter(Boolean);
    const text = ['Merhaba, web sitenizden teklif almak istiyorum.', '', ...details].join('\n');
    window.open(`https://wa.me/${CONTACT.whatsapp}?text=${encodeURIComponent(text)}`, '_blank', 'noopener');
    dialog.close();
    form.reset();
  });
</script>
