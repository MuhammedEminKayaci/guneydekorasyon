---
// Ürün sayfası galerisi: ana görsel + küçük resimler, oklar, dokunmatik kaydırma, tam ekran yakınlaştırma.
import { Image, getImage } from 'astro:assets';
import Icon from '../ui/Icon.astro';
import type { ImageMetadata } from 'astro';

export interface Props {
  images: ImageMetadata[];
  alt: string;
  fit: 'contain' | 'cover';
}

const { images, alt, fit } = Astro.props;
const cover = fit === 'cover';
const zoomSrcs = await Promise.all(images.map(async (img) => (await getImage({ src: img, width: 1800, format: 'webp' })).src));
const multi = images.length > 1;
---

<div class="product-gallery" data-gallery>
  <div class="relative overflow-hidden rounded-3xl bg-galvanized">
    <div class="relative aspect-square">
      {
        images.map((img, i) => (
          <button
            type="button"
            class:list={['gallery-slide absolute inset-0 cursor-zoom-in', i === 0 && 'is-active']}
            aria-label={`${alt}, görsel ${i + 1}: büyüt`}
            aria-hidden={i === 0 ? 'false' : 'true'}
            tabindex={i === 0 ? 0 : -1}
            data-slide={i}
            data-zoom={zoomSrcs[i]}
          >
            <Image
              src={img}
              alt={images.length > 1 ? `${alt}, görsel ${i + 1}` : alt}
              widths={[480, 720, 960, 1280]}
              sizes="(min-width: 1280px) 40rem, (min-width: 1024px) 50vw, 100vw"
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : 'auto'}
              class:list={['size-full', cover ? 'object-cover' : 'object-contain p-8 mix-blend-multiply sm:p-14']}
            />
          </button>
        ))
      }
    </div>

    {
      multi && (
        <>
          <button type="button" class="gallery-nav left-4" aria-label="Önceki görsel" data-step="-1">
            <Icon name="ChevronLeft" class="size-5" />
          </button>
          <button type="button" class="gallery-nav right-4" aria-label="Sonraki görsel" data-step="1">
            <Icon name="ChevronRight" class="size-5" />
          </button>
          <span class="absolute bottom-4 left-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold tabular-nums backdrop-blur" data-counter>
            1 / {images.length}
          </span>
        </>
      )
    }
    <span class="pointer-events-none absolute right-4 bottom-4 grid size-10 place-items-center rounded-full bg-white/90 text-steel-700 backdrop-blur" aria-hidden="true">
      <Icon name="Maximize2" class="size-4" />
    </span>
  </div>

  {
    multi && (
      <div class="mt-4 grid grid-cols-5 gap-3" role="tablist" aria-label="Görsel seç">
        {images.map((img, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`${i + 1}. görsel`}
            class="aspect-square overflow-hidden rounded-xl border-2 border-transparent bg-galvanized transition-colors hover:border-steel-300 aria-selected:border-signal-500"
            data-thumb={i}
          >
            <Image src={img} alt="" width={120} densities={[1, 2]} class:list={['size-full', cover ? 'object-cover' : 'object-contain p-1.5 mix-blend-multiply']} />
          </button>
        ))}
      </div>
    )
  }
</div>

<dialog
  class="zoom-dialog m-0 h-dvh max-h-none w-full max-w-none bg-white p-0 backdrop:bg-steel-950"
  aria-label="Görsel büyütme"
  data-zoom-dialog
>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4 border-b border-steel-200 px-5 py-3">
      <p class="truncate font-semibold">{alt}</p>
      <div class="flex items-center gap-3">
        {multi && <span class="text-sm text-steel-500 tabular-nums" data-zoom-counter />}
        <button type="button" class="grid size-10 place-items-center rounded-full bg-galvanized hover:bg-steel-200" aria-label="Kapat" data-zoom-close>
          <Icon name="X" class="size-5" />
        </button>
      </div>
    </div>
    <div class="relative flex-1 overflow-auto">
      <img alt="" class="mx-auto h-full w-auto max-w-none cursor-zoom-in object-contain" data-zoom-image />
      {
        multi && (
          <>
            <button type="button" class="gallery-nav left-4" aria-label="Önceki görsel" data-zoom-step="-1">
              <Icon name="ChevronLeft" class="size-5" />
            </button>
            <button type="button" class="gallery-nav right-4" aria-label="Sonraki görsel" data-zoom-step="1">
              <Icon name="ChevronRight" class="size-5" />
            </button>
          </>
        )
      }
    </div>
  </div>
</dialog>

<style>
  .gallery-slide {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 350ms var(--ease-out-quart),
      visibility 0s linear 350ms;
  }
  .gallery-slide.is-active {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s;
  }
  .gallery-nav {
    position: absolute;
    top: 50%;
    z-index: 10;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border-radius: 9999px;
    background: white;
    box-shadow: 0 6px 16px -6px rgb(8 13 20 / 0.35);
    transform: translateY(-50%);
    transition: background 150ms;
  }
  .gallery-nav:hover {
    background: var(--color-galvanized);
  }
  /* Tam ekranda ikinci tıklama gerçek boyuta yakınlaştırır */
  .zoom-dialog[data-zoomed] [data-zoom-image] {
    height: auto;
    max-height: none;
    width: 160%;
    cursor: zoom-out;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLButtonElement>('[data-slide]')];
    const thumbs = [...root.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const counter = root.querySelector<HTMLElement>('[data-counter]');
    const dialog = root.nextElementSibling as HTMLDialogElement;
    const zoomImg = dialog.querySelector<HTMLImageElement>('[data-zoom-image]')!;
    const zoomCounter = dialog.querySelector<HTMLElement>('[data-zoom-counter]');
    let current = 0;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      slides.forEach((s, j) => {
        s.classList.toggle('is-active', j === current);
        s.setAttribute('aria-hidden', String(j !== current));
        s.tabIndex = j === current ? 0 : -1;
      });
      thumbs.forEach((t, j) => t.setAttribute('aria-selected', String(j === current)));
      if (counter) counter.textContent = `${current + 1} / ${slides.length}`;
      if (dialog.open) syncZoom();
    };
    const syncZoom = () => {
      zoomImg.src = slides[current].dataset.zoom!;
      zoomImg.alt = slides[current].getAttribute('aria-label')!.replace(': büyüt', '');
      if (zoomCounter) zoomCounter.textContent = `${current + 1} / ${slides.length}`;
    };

    root.querySelectorAll<HTMLElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.step))));
    thumbs.forEach((t) => t.addEventListener('click', () => show(Number(t.dataset.thumb))));
    slides.forEach((s) =>
      s.addEventListener('click', () => {
        syncZoom();
        dialog.removeAttribute('data-zoomed');
        dialog.showModal();
      }),
    );

    dialog.querySelectorAll<HTMLElement>('[data-zoom-step]').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.zoomStep))));
    dialog.querySelector('[data-zoom-close]')!.addEventListener('click', () => dialog.close());
    zoomImg.addEventListener('click', () => dialog.toggleAttribute('data-zoomed'));

    const onKey = (e: KeyboardEvent) => {
      if (slides.length < 2) return;
      if (e.key === 'ArrowRight') show(current + 1);
      if (e.key === 'ArrowLeft') show(current - 1);
    };
    root.addEventListener('keydown', onKey);
    dialog.addEventListener('keydown', onKey);

    // Dokunmatik kaydırma
    let startX = 0;
    root.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    root.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].clientX - startX;
        if (slides.length > 1 && Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
      },
      { passive: true },
    );
  });
</script>
