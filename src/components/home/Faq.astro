---
import { Image } from 'astro:assets';
import { FAQ } from '../../data/home';
import { whatsappLink } from '../../config/site';
import Icon from '../ui/Icon.astro';
import BrandIcon from '../ui/BrandIcon.astro';
---

<section id="sss" class="bg-galvanized py-16 sm:py-24" aria-labelledby="sss-baslik">
  <div class="container-page grid gap-12 lg:grid-cols-5 lg:gap-16">
    <div class="lg:col-span-2">
      <div class="lg:sticky lg:top-28">
        <h2 id="sss-baslik" class="section-title">Sıkça sorulan sorular</h2>
        <p class="section-lead">Sipariş, üretim ve montaj süreci hakkında en çok sorulanlar.</p>
        <Image
          src={FAQ.image}
          alt="Montajı tamamlanmış giyim mağazası"
          widths={[480, 720]}
          sizes="(min-width: 1024px) 35vw, 100vw"
          class="mt-8 hidden aspect-4/3 w-full rounded-3xl object-cover lg:block"
        />
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href={whatsappLink('Merhaba, bir sorum var.')}
            class="btn-whatsapp rounded-full px-6"
            target="_blank"
            rel="noopener"
          >
            <BrandIcon name="whatsapp" class="size-5" />
            WhatsApp'tan sorun
          </a>
          <a href="/iletisim/" class="btn-outline rounded-full px-6">İletişim bilgileri</a>
        </div>
      </div>
    </div>

    <div class="divide-y divide-steel-200 border-y border-steel-200 lg:col-span-3">
      {
        FAQ.items.map((item, i) => (
          <details class="faq group" name="sss" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-5 text-lg font-semibold [&::-webkit-details-marker]:hidden">
              {item.q}
              <span class="grid size-8 shrink-0 place-items-center rounded-full border border-steel-300 transition-colors group-open:border-signal-500 group-open:bg-signal-500 group-open:text-white">
                <Icon name="Plus" class="size-4 transition-transform duration-300 group-open:rotate-45" />
              </span>
            </summary>
            <div class="faq-body">
              <p class="max-w-2xl pb-6 text-steel-700">{item.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Açılma animasyonu: destekleyen tarayıcılarda yükseklik geçişi */
  @supports (interpolate-size: allow-keywords) {
    .faq {
      interpolate-size: allow-keywords;
    }
    .faq::details-content {
      height: 0;
      overflow: clip;
      transition:
        height 300ms var(--ease-out-quart),
        content-visibility 300ms allow-discrete;
    }
    .faq[open]::details-content {
      height: auto;
    }
  }
</style>
