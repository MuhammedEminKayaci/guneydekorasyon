---
// Footer öncesi son eylem çağrısı.
import { CONTACT, whatsappLink } from '../../config/site';
import Icon from '../ui/Icon.astro';
import BrandIcon from '../ui/BrandIcon.astro';
---

<section class="py-16 sm:py-20" aria-labelledby="teklif-baslik">
  <div class="container-page">
    <div class="grid items-center gap-8 border border-steel-200 p-6 sm:p-10 lg:grid-cols-[1fr_auto] lg:gap-12 lg:p-12">
      <div>
        <h2 id="teklif-baslik" class="text-2xl leading-tight font-bold sm:text-3xl">
          Mağazanızın ölçülerini gönderin, size özel teklif hazırlayalım
        </h2>
        <p class="mt-3 max-w-2xl text-steel-500">
          Fotoğraf ve kabaca ölçü yeterli. Gerekirse yerinde keşif için randevu planlıyoruz.
        </p>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a
          href={whatsappLink('Merhaba, mağazam için teklif almak istiyorum.')}
          class="btn-whatsapp"
          target="_blank"
          rel="noopener"
        >
          <BrandIcon name="whatsapp" class="size-5" />
          WhatsApp'tan gönderin
        </a>
        <a href={`tel:${CONTACT.phones[0].tel}`} class="btn-outline">
          <Icon name="Phone" class="size-4" />
          {CONTACT.phones[0].display}
        </a>
      </div>
    </div>
  </div>
</section>
