---
// Sayfa yolu. Son öğe mevcut sayfadır (link değil). Schema verisi sayfa tarafında breadcrumbSchema ile eklenir.
import Icon from './Icon.astro';

export interface Props {
  items: { name: string; href: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
const all = [{ name: 'Ana sayfa', href: '/' }, ...items];
---

<nav aria-label="Sayfa yolu" class={className}>
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1 text-sm text-steel-500">
    {
      all.map((item, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <Icon name="ChevronRight" class="size-3.5 text-steel-300" />}
          {i === all.length - 1 ? (
            <span aria-current="page" class="font-medium text-steel-900">
              {item.name}
            </span>
          ) : (
            <a href={item.href} class="transition-colors hover:text-signal-500">
              {i === 0 ? (
                <>
                  <Icon name="House" class="size-4" />
                  <span class="sr-only">{item.name}</span>
                </>
              ) : (
                item.name
              )}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
