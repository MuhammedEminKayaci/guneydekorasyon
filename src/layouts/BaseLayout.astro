---
// Tüm sayfaların ortak iskeleti.
import { Font } from 'astro:assets';
import Seo, { type Props as SeoProps } from '../components/seo/Seo.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import QuickView from '../components/product/QuickView.astro';
import MobileActionBar from '../components/layout/MobileActionBar.astro';
import { SITE } from '../config/site';
import '../styles/global.css';

export type Props = SeoProps & {
  /** Sayfa kendi mobil eylem çubuğunu gösteriyorsa (ör. ürün sayfası) genel çubuğu gizle */
  hideMobileBar?: boolean;
};

const { hideMobileBar = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#080d14" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} Blog`} href="/blog/rss.xml" />
    <Font cssVariable="--font-archivo" preload />
    <Seo {...seo} />
  </head>
  <body class="pb-[calc(4rem+env(safe-area-inset-bottom))] lg:pb-0">
    <Header />
    <main id="icerik">
      <slot />
    </main>
    <Footer />
    <QuickView />
    {!hideMobileBar && <MobileActionBar />}
  </body>
</html>
