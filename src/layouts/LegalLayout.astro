---
// Yasal metin sayfaları (KVKK, çerez politikası) için sade okuma düzeni.
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';

export interface Props {
  title: string;
  description: string;
  path: string;
  updated: string;
}

const { title, description, path, updated } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="container-page py-10 lg:py-14">
    <Breadcrumbs items={[{ name: title, href: path }]} />
    <article class="legal mx-auto mt-8 max-w-3xl">
      <h1 class="text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl">{title}</h1>
      <p class="mt-3 text-sm text-steel-500">Son güncelleme: {updated}</p>
      <div class="mt-8">
        <slot />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .legal :global(h2) {
    margin-top: 2.25rem;
    font-size: 1.25rem;
    font-weight: 700;
  }
  .legal :global(p),
  .legal :global(ul) {
    margin-top: 0.875rem;
    color: var(--color-steel-700);
    line-height: 1.75;
  }
  .legal :global(ul) {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal :global(li + li) {
    margin-top: 0.375rem;
  }
  .legal :global(a) {
    color: var(--color-signal-500);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
