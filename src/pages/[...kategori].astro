---
// Tüm kategori sayfaları: /raf-sistemleri/, /mankenler/terzi-mankeni/, /askilar/ahsap-aski/ceket/ …
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Icon from '../components/ui/Icon.astro';
import BrandIcon from '../components/ui/BrandIcon.astro';
import ProductListing from '../components/product/ProductListing.astro';
import QuoteBand from '../components/home/QuoteBand.astro';
import { allCategoryNodes, productsIn, countIn, type CategoryNode } from '../lib/catalog';
import { contentFor } from '../data/category-content';
import { breadcrumbSchema, faqSchema } from '../lib/schema';
import { SITE, whatsappLink } from '../config/site';

export const getStaticPaths = (() =>
  allCategoryNodes().map((node) => ({
    params: { kategori: node.path.join('/') },
    props: { node },
  }))) satisfies GetStaticPaths;

interface Props {
  node: CategoryNode;
}

const { node } = Astro.props;
const parent = node.trail.at(-2);
const content = contentFor(node.path, node.name, parent?.name);
const products = productsIn(node.path);
const children = node.children.map((c) => ({ ...c, count: countIn([...node.path, c.slug]) }));

// Kardeş kategoriler (aynı seviyedeki diğer düğümler)
const siblings = allCategoryNodes().filter(
  (n) =>
    n.path.length === node.path.length &&
    n.path.slice(0, -1).join('/') === node.path.slice(0, -1).join('/') &&
    n.href !== node.href,
);

const jsonLd = [
  breadcrumbSchema([{ name: 'Ana sayfa', path: '/' }, ...node.trail.map((t) => ({ name: t.name, path: t.href }))]),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: content.metaTitle,
    description: content.metaDescription,
    url: new URL(node.href, SITE.url).href,
    numberOfItems: products.length,
  },
  ...(content.faq ? [faqSchema(content.faq)] : []),
];
---

<BaseLayout title={content.metaTitle} description={content.metaDescription} image={node.image.src} jsonLd={jsonLd}>
  <!-- Başlık -->
  <section class="border-b border-steel-200 bg-galvanized">
    <div class="container-page pt-6 pb-10 lg:pb-12">
      <Breadcrumbs items={node.trail} />

      <div class="mt-6 grid items-center gap-8 lg:grid-cols-[1fr_auto]">
        <div class="max-w-3xl">
          <h1 class="text-4xl leading-tight font-extrabold tracking-tight sm:text-5xl">{node.name}</h1>
          <p class="mt-4 text-lg text-steel-700">{content.intro}</p>
          <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium text-steel-700" role="list">
            <li class="flex items-center gap-1.5"><Icon name="Package" class="size-4 text-signal-500" />{products.length} model</li>
            <li class="flex items-center gap-1.5"><Icon name="Ruler" class="size-4 text-signal-500" />Ölçüye özel üretim</li>
            <li class="flex items-center gap-1.5"><Icon name="Truck" class="size-4 text-signal-500" />Türkiye geneli teslimat ve montaj</li>
          </ul>
        </div>
        <div class="hidden size-44 overflow-hidden rounded-3xl bg-white lg:block xl:size-52">
          <Image src={node.image} alt="" width={208} densities={[1, 2]} class="size-full object-contain p-4 mix-blend-multiply" loading="eager" />
        </div>
      </div>

      {
        children.length > 0 && (
          <ul
            class="-mx-4 mt-8 flex snap-x gap-3 overflow-x-auto scroll-px-4 px-4 pb-1 [scrollbar-width:none] sm:mx-0 sm:grid sm:grid-cols-3 sm:overflow-visible sm:px-0 lg:grid-cols-5 [&::-webkit-scrollbar]:hidden"
            role="list"
            aria-label="Alt kategoriler"
          >
            {children.map((c) => (
              <li class="w-44 shrink-0 snap-start sm:w-auto">
                <a
                  href={c.href}
                  class="group flex h-full items-center gap-3 rounded-2xl border border-steel-200 bg-white p-2.5 pr-4 transition-colors hover:border-steel-900"
                >
                  <Image
                    src={c.image}
                    alt=""
                    width={64}
                    densities={[1, 2]}
                    class="size-14 shrink-0 rounded-xl bg-galvanized object-contain p-1 mix-blend-multiply"
                  />
                  <span class="min-w-0">
                    <span class="block leading-snug font-semibold group-hover:text-signal-500">{c.name}</span>
                    <span class="text-xs text-steel-500">{c.count} model</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  <!-- Ürünler -->
  <div class="container-page py-10 lg:py-12">
    <ProductListing
      products={products}
      categoryFacet={children.length > 1 ? { label: 'Kategori', depth: node.path.length, options: children } : undefined}
      showCategory={children.length > 1}
      context={node.name}
    />
  </div>

  <!-- İçerik + SSS -->
  <section class="border-t border-steel-200 py-14 lg:py-20" aria-labelledby="kategori-bilgi">
    <div class="container-page grid gap-12 lg:grid-cols-[1fr_22rem] lg:gap-16">
      <div>
        <h2 id="kategori-bilgi" class="section-title">{node.name} hakkında</h2>
        <div class="mt-6 max-w-3xl space-y-4 text-lg leading-relaxed text-steel-700">
          {content.body.map((p) => <p>{p}</p>)}
        </div>

        {
          content.faq && (
            <div class="mt-12 max-w-3xl">
              <h2 class="text-2xl font-bold">Sıkça sorulan sorular</h2>
              <div class="mt-5 divide-y divide-steel-200 border-y border-steel-200">
                {content.faq.map((item, i) => (
                  <details class="group" name="kategori-sss" open={i === 0}>
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 py-4 font-semibold [&::-webkit-details-marker]:hidden">
                      {item.q}
                      <Icon name="Plus" class="size-5 shrink-0 text-steel-500 transition-transform group-open:rotate-45" />
                    </summary>
                    <p class="pb-5 text-steel-700">{item.a}</p>
                  </details>
                ))}
              </div>
            </div>
          )
        }
      </div>

      <aside class="h-fit rounded-3xl bg-steel-950 p-7 text-white lg:sticky lg:top-40">
        <p class="text-xl leading-snug font-bold">Mağazanıza özel {node.name.toLocaleLowerCase('tr')}</p>
        <p class="mt-2 text-steel-300">
          Katalogdaki modeller örnektir. Ölçü, renk ve adedinizi yazın, size özel fiyat teklifi hazırlayalım.
        </p>
        <div class="mt-6 grid gap-3">
          <button type="button" class="btn-primary rounded-full" data-quote-open>Teklif Al</button>
          <a href={whatsappLink(`Merhaba, ${node.name} için bilgi almak istiyorum.`)} target="_blank" rel="noopener" class="btn-glass rounded-full">
            <BrandIcon name="whatsapp" class="size-5" />
            WhatsApp'tan sorun
          </a>
        </div>
      </aside>
    </div>
  </section>

  {
    siblings.length > 0 && (
      <section class="border-t border-steel-200 bg-galvanized py-14" aria-labelledby="diger-kategoriler">
        <div class="container-page">
          <h2 id="diger-kategoriler" class="text-2xl font-bold">
            {parent ? `Diğer ${parent.name.toLocaleLowerCase('tr')}` : 'Diğer ürün grupları'}
          </h2>
          <ul class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5" role="list">
            {siblings.map((s) => (
              <li>
                <a href={s.href} class="group block rounded-2xl bg-white p-3 transition-shadow hover:shadow-[0_16px_32px_-20px_rgb(8_13_20/0.4)]">
                  <span class="block aspect-4/3 overflow-hidden rounded-xl bg-galvanized">
                    <Image src={s.image} alt="" width={240} densities={[1, 2]} loading="lazy" class="size-full object-contain p-3 mix-blend-multiply transition-transform duration-500 group-hover:scale-105" />
                  </span>
                  <span class="mt-3 flex items-center justify-between gap-2 px-1 font-semibold group-hover:text-signal-500">
                    {s.name}
                    <span class="text-xs font-normal text-steel-500">{countIn(s.path)}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <QuoteBand />
</BaseLayout>
