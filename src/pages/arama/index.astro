---
// Arama sonuçları: ?q= ile açılır. Liste, sorguyu URL'den okuyup ürünleri filtreler;
// eşleşen kategoriler ayrıca üstte gösterilir. Arama sayfaları dizine eklenmez.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/ui/Breadcrumbs.astro';
import ProductListing from '../../components/product/ProductListing.astro';
import { PRODUCTS } from '../../lib/catalog';
import { CATEGORIES } from '../../data/categories';
---

<BaseLayout title="Arama" description="Güney Mağaza Dekorasyon ürün kataloğunda arama." noindex>
  <section class="border-b border-steel-200 bg-galvanized">
    <div class="container-page pt-6 pb-10">
      <Breadcrumbs items={[{ name: 'Arama', href: '/arama/' }]} />
      <h1 class="mt-6 text-3xl leading-tight font-extrabold tracking-tight sm:text-4xl" data-search-title>Arama</h1>
      <p class="mt-3 text-steel-700" data-search-lead>Aradığınız ürünü, kategoriyi veya katalog numarasını yazın.</p>
      <div class="mt-6 hidden" data-search-cats>
        <p class="text-sm font-semibold text-steel-500">Eşleşen kategoriler</p>
        <ul class="mt-3 flex flex-wrap gap-2" role="list" data-search-cat-list></ul>
      </div>
    </div>
  </section>

  <div class="container-page py-10 lg:py-12">
    <ProductListing
      products={PRODUCTS}
      categoryFacet={{ label: 'Kategori', depth: 0, options: CATEGORIES.map((c) => ({ slug: c.slug, name: c.name })) }}
      showCategory
      context="arama sonuçları"
    />
  </div>
</BaseLayout>

<script>
  import { loadCatalog, normalize, matchesAll, escapeHtml } from '../../scripts/catalog-client';

  const title = document.querySelector<HTMLElement>('[data-search-title]')!;
  const lead = document.querySelector<HTMLElement>('[data-search-lead]')!;
  const catsWrap = document.querySelector<HTMLElement>('[data-search-cats]')!;
  const catList = document.querySelector<HTMLElement>('[data-search-cat-list]')!;
  const listSearch = document.querySelector<HTMLInputElement>('[data-list-search]');
  const baseTitle = document.title;

  async function update() {
    const q = (new URLSearchParams(location.search).get('q') ?? '').trim();
    title.textContent = q ? `“${q}” için sonuçlar` : 'Tüm ürünlerde arama';
    document.title = q ? `“${q}” araması | Güney Mağaza Dekorasyon` : baseTitle;
    lead.textContent = q
      ? 'Sonuçları kategori, renk ve tipe göre daraltabilirsiniz.'
      : 'Aradığınız ürünü, kategoriyi veya katalog numarasını yazın.';
    const tokens = normalize(q).split(' ').filter(Boolean);
    if (!tokens.length) return catsWrap.classList.add('hidden');
    const { categories } = await loadCatalog();
    const hits = categories
      .filter((c) => matchesAll(normalize(`${c.name} ${c.path}`).split(' '), tokens))
      .slice(0, 8);
    catsWrap.classList.toggle('hidden', !hits.length);
    catList.innerHTML = hits
      .map(
        (c) =>
          `<li><a href="${c.href}" class="inline-flex items-center gap-2 rounded-full border border-steel-200 bg-white py-1.5 pr-4 pl-1.5 text-sm font-medium hover:border-steel-900"><img src="${c.thumb}" alt="" width="28" height="28" class="size-7 rounded-full object-contain" />${escapeHtml(c.name)} <span class="text-steel-500">${c.count}</span></a></li>`,
      )
      .join('');
  }

  update();
  // Liste içi arama değişince başlık ve kategori önerileri de güncellensin
  listSearch?.addEventListener('input', () => window.setTimeout(update, 200));
</script>
