---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
import { CATEGORIES, categoryHref } from '../data/categories';
import redirects from '../data/redirects.json';
---

<BaseLayout title="Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı." noindex>
  <section class="container-page py-16 text-center lg:py-24">
    <p class="text-sm font-semibold text-signal-500">404</p>
    <h1 class="mt-3 text-4xl leading-tight font-extrabold tracking-tight sm:text-5xl">Bu sayfa taşınmış olabilir</h1>
    <p class="mx-auto mt-4 max-w-xl text-lg text-steel-700">
      Sitemizi yeniledik; eski bağlantılar değişmiş olabilir. Aradığınız ürünü aşağıdaki kategorilerden veya
      aramadan bulabilirsiniz.
    </p>
    <form action="/arama/" method="get" role="search" class="relative mx-auto mt-8 max-w-lg">
      <label for="bulunamadi-arama" class="sr-only">Ürün ara</label>
      <Icon name="Search" class="pointer-events-none absolute top-1/2 left-5 size-5 -translate-y-1/2 text-steel-500" />
      <input
        id="bulunamadi-arama"
        name="q"
        type="search"
        placeholder="Ürün, kategori veya katalog no"
        class="h-14 w-full rounded-full border border-steel-200 bg-white pr-28 pl-13 text-base outline-none focus:border-steel-900"
      />
      <button type="submit" class="btn-primary absolute top-1.5 right-1.5 min-h-11 rounded-full px-6">Ara</button>
    </form>

    <ul class="mx-auto mt-14 grid max-w-5xl grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5" role="list">
      {
        CATEGORIES.map((cat) => (
          <li>
            <a href={categoryHref(cat.slug)} class="group block rounded-2xl bg-galvanized p-3">
              <Image src={cat.image} alt="" width={200} densities={[1, 2]} class="aspect-square w-full object-contain p-2 mix-blend-multiply" />
              <span class="mt-2 block font-semibold group-hover:text-signal-500">{cat.name}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a href="/" class="btn-outline mt-10 rounded-full px-6">Ana sayfaya dönün</a>
  </section>
  <!-- Sunucu yönlendirmesi (.htaccess/_redirects) yoksa eski adresleri burada yeni sayfalara taşı -->
  <script is:inline define:vars={{ redirects }}>
    (function () {
      var path = decodeURIComponent(location.pathname).normalize('NFC');
      var target = redirects[path];
      if (target) location.replace(target + location.hash);
    })();
  </script>
</BaseLayout>
