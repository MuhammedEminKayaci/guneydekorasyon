---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import Categories from '../components/home/Categories.astro';
import About from '../components/home/About.astro';
import Promises from '../components/home/Promises.astro';
import Testimonials from '../components/home/Testimonials.astro';
import Faq from '../components/home/Faq.astro';
import QuoteBand from '../components/home/QuoteBand.astro';
import { faqSchema, localBusinessSchema } from '../lib/schema';
import { FAQ, HERO_SLIDES } from '../data/home';
---

<BaseLayout
  description="İstanbul Güngören'de mağaza raf sistemleri, orta sistemler, standlar, vitrin mankenleri ve askılar üretiyoruz. Ölçüye özel tasarım, Türkiye geneli montaj, 2 yıl garanti."
  image={HERO_SLIDES[0].image.src}
  jsonLd={[localBusinessSchema(), faqSchema(FAQ.items)]}
>
  <Hero />
  <Categories />
  <About />
  <Promises />
  <Testimonials />
  <Faq />
  <QuoteBand />
</BaseLayout>
