      <rules>
        <rule name="Eski sayfalar yeni karsiliklarina" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAny">
            <add input="{EskiAdresler:{URL}}" pattern="(.+)" />
            <add input="{EskiAdresler:{UNENCODED_URL}}" pattern="(.+)" />
          </conditions>
          <action type="Redirect" url="{C:1}" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Kalan her sey yeni ana sayfaya" stopProcessing="true">
          <match url=".*" />
          <action type="Redirect" url="https://guneydekorasyonraf.com/" redirectType="Permanent" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
